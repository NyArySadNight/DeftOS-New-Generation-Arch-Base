#!/usr/bin/env bash
# deftinstall-ui: runs the installer UI on localhost and opens it in a browser.
# 1. Scans this machine into hw.js (read-only).
# 2. Serves the UI on 127.0.0.1 only.
# The UI generates archinstall.json; save it, then run: sudo deftinstall --config FILE
set -euo pipefail

UI_DIR="${DEFTOS_UI_DIR:-/usr/share/deftos/installer-ui}"
PORT="${DEFTOS_UI_PORT:-8765}"

if command -v deftos-hwscan >/dev/null 2>&1; then
    deftos-hwscan "$UI_DIR/hw.js" || echo "[deftinstall-ui] Hardware scan failed; the UI will show demo data." >&2
fi

cd "$UI_DIR"
python3 -m http.server --bind 127.0.0.1 "$PORT" >/dev/null 2>&1 &
SERVER=$!
trap 'kill "$SERVER" 2>/dev/null || true' EXIT
sleep 1

URL="http://127.0.0.1:$PORT/"
echo "DeftOS installer UI: $URL  (Ctrl+C to stop)"
if command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1 || true; fi
wait "$SERVER"
