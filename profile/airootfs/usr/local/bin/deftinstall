#!/usr/bin/env bash
# DeftOS-Install: archinstall với cấu hình DeftOS (kernel linux-deftos, Cinnamon).
# Khung cài đặt là của archinstall; cấu hình và kernel là của DeftOS.
set -euo pipefail
source /etc/deftos/install.conf

# Nhập khóa ký repo DeftOS vào keyring của live (để tải gói từ repo [deftos])
if [[ -f /etc/deftos/repo-signing-key.asc ]]; then
    pacman-key --add /etc/deftos/repo-signing-key.asc >/dev/null 2>&1 || true
fi

CFG=$(mktemp /tmp/deftos-install.XXXXXX.json)
if curl -fsSL --max-time 20 "$DEFTOS_REPO_RAW/$DEFTOS_CONFIG_PATH" -o "$CFG"; then
    echo "[DeftOS-Install] Đã tải cấu hình từ repo DeftOS."
else
    echo "[DeftOS-Install] Không tải được từ repo, dùng cấu hình đi kèm ISO."
    cp "$DEFTOS_LOCAL_CONFIG" "$CFG"
fi

exec archinstall --config "$CFG" "$@"
